          }
        },

        {
          "name": "Get Company by ID",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{officerToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/v1/placement-officers/me/companies/{{companyId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api","v1","placement-officers","me","companies","{{companyId}}"]
            }
          }
        },

        {
          "name": "Update Company Info",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{officerToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"companyName\": \"Updated Company Ltd\",\n  \"phone\": \"0000000000\",\n  \"website\": \"https://updatedcompany.com\",\n  \"address\": \"Updated Address\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/placement-officers/me/companies/{{companyId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api","v1","placement-officers","me","companies","{{companyId}}"]
            }
          }
        }

      ]
    }

  ]
}
