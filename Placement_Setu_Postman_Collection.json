              "path": ["api","v1","placement-officers","me","companies"],
              "query": [
                { "key": "page", "value": "0" },
                { "key": "size", "value": "20" },
                { "key": "status", "value": "ACTIVE", "disabled": true, "description": "Filter: PENDING | ACTIVE | REJECTED | SUSPENDED" }
              ]
