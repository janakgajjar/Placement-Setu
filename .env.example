# ============================================================================
# Placement Setu — Master Environment Variables Template
# Copy this file to .env and fill in your actual credentials.
# ============================================================================

# 1. PostgreSQL Database Configuration
# Obtain from local Postgres (localhost:5432) OR cloud (Neon.tech / Supabase / Render)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=placement_setu
DB_USERNAME=postgres
DB_PASSWORD=placment_setu_password

# 2. JWT Security Secret
# Any random string with at least 32 characters
JWT_SECRET=placement_setu_secret_key_minimum_32_characters_long_2026

# 3. CORS Allowed Origins (Comma-separated)
# Include your local frontend port and your live Vercel URL
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://placement-setu.vercel.app

# 4. Google Gemini AI API Key (Resume Parsing Engine)
# Obtain free from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSyYourActualGeminiApiKeyHere

# 5. Email Agent & SMTP Configuration
# Set to 'true' for real email delivery; 'false' for safe local development sandbox
MAIL_ENABLED=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your.placement.email@gmail.com
# Gmail 16-character App Password (Google Account -> Security -> App Passwords)
MAIL_PASSWORD=your_16_digit_app_password
MAIL_FROM=noreply@placementsetu.gujaratvidyapith.edu
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
MAIL_MAX_RETRIES=3
MAIL_POLL_INTERVAL_MS=5000

# 6. Frontend Public Base URL (Used in email template action buttons)
APP_BASE_URL=http://localhost:5173

# 7. Frontend API Base URL (Used by React/Vite in frontend/.env)
VITE_API_BASE_URL=http://localhost:8080
